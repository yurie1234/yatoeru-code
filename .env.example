# DB (Railway MySQLプラグインを追加すると自動で発行される接続文字列を貼る)
DATABASE_URL=mysql://user:password@host:port/database

# AI (Anthropic Claude直呼び。server/_core/llm.ts)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# 管理画面ログイン (server/_core/sdk.ts, adminAuth.ts)
ADMIN_PASSWORD=change-me
# セッションJWTの署名鍵。 `openssl rand -hex 32` 等で新規生成すること
JWT_SECRET=

# 週次/月次同期ジョブ(旧Manus Agent cron)を叩く共有シークレット (Authorization: Bearer <値>)
CRON_SECRET=

NODE_ENV=production
